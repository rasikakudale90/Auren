# AUREN Frontend Environment Variables

# Toggle mock data service (true for frontend-first prototype, false when connecting to Spring Boot backend)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Backend API Base URL (used when mock data is disabled)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME=AUREN
NEXT_PUBLIC_APP_URL=http://localhost:3000
